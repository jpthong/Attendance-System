@{
    ViewData["Title"] = "Enroll Student";
}

<h2>Enroll Student</h2>

<form asp-action="Enroll" method="post"> 
<input type="hidden" name="id" value="@ViewBag.ClassId" />
<select name="studentId" class="form-select"
    asp-items="@(new SelectList(ViewBag.Students, "Id", "FullName"))"> 
    <option value="">Select a Student </option>
    </select>
<button type="submit" class="btn btn-primary">Enroll</button>
</form>