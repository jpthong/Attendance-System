@{
    ViewData["Title"] = "Take Attendance";
}

<h2>Take Attendance - ViewBag.ClassName</h2>

<form asp-action="TakeAttendance" method="post">
<input type="hidden" name="id" value="@ViewBag.ClassId" />
    <table class="table w-50">

        @foreach (var s in ViewBag.Students){
            <tr>
                <td>@s.FullName</td>
                <td>
                    <select name="statuses[@s.Id]" class="form-select">  
                        <option value="Present">Present</option>
                        <option value="Late">Late</option>
                        <option value="Absent">Absent</option>
                    </select>
                </td>
            </tr>
    }

    </table>
<button type="submit" class="btn btn-primary">Save Attendance</button>
</form>    