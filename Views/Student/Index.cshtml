@model List<AttendanceSystem.Models.ClassRoom>
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="text-center">
    <h1 class="display-4">Student Dashboard</h1>
    <table class="table w-50 mx-auto"> 
        <thead> <tr class="fs-4"><th>Subject</th><th>Section</th><th></th></tr> </thead>
        <tbody>    
            @foreach (var c in Model) {
                <tr> 
                    <td>@c.SubjectName</td>
                    <td>@c.Section</td>
                    <td><a asp-action="Attendance" asp-route-id="@c.Id">View Attendance</a></td>
                </tr>
        }
        </tbody>
    </table>
</div>
